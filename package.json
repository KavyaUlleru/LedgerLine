{
  "name": "ledgerline-root",
  "version": "1.0.0",
  "description": "LedgerLine - Immutable, Double-Entry Financial Account Management & Audit Platform",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
